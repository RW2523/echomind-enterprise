# Backend with NeMo ASR for NVIDIA DGX Spark (Ubuntu, GPU).
# Build: docker compose build backend   (from livetranscript/ directory)
# Run with GPU: docker compose up
# Offline: Nemotron weights are pre-downloaded into the image at build time.
#           Set HF_TOKEN in your environment/shell before building if the model is gated.
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    libsndfile1 \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir Cython packaging

# NeMo from git (required for nvidia/nemotron-speech-streaming-en-0.6b)
RUN pip install --no-cache-dir "nemo_toolkit[asr] @ git+https://github.com/NVIDIA/NeMo.git@main"

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download Nemotron ASR weights at build time so the container runs fully offline.
# Pass HF_TOKEN as a build-arg if the model is gated: docker compose build --build-arg HF_TOKEN=<token>
ARG HF_TOKEN=
ARG ECHOMIND_ASR_MODEL_NAME=nvidia/nemotron-speech-streaming-en-0.6b
ARG SKIP_MODEL_DOWNLOAD=0
RUN export HF_TOKEN="${HF_TOKEN}" && \
    if [ "${SKIP_MODEL_DOWNLOAD}" != "1" ]; then \
      python3 -c "from huggingface_hub import snapshot_download; snapshot_download('${ECHOMIND_ASR_MODEL_NAME}')"; \
    fi

COPY backend/ /app/

# Offline runtime: use only the HF cache baked into the image — no network access to Hugging Face.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HOST=0.0.0.0
ENV PORT=8000
EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
