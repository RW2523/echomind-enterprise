# Recorded security-relevant runtime settings of the reference instance (SOP-06 §10.1).
# Non-secret values only — secrets (AUTH_SECRET, passwords, tunnel token) are never recorded here.
# "<unset>" means the variable is absent from .env, so the code default applies.
# Change a value only together with a REG-07 entry; scripts/check_runtime_config.sh reports drift.
# Baseline as of 2026-10-07 (REG-07 DC-2026-001, -004, -005, -006).
AUTH_ENABLED=1
VOICE_AUTH_ENABLED=1
CORS_ALLOW_ORIGINS=<unset>
RATE_LIMIT_PER_MIN=<unset>
AUTH_TOKEN_TTL_MIN=<unset>
BUILD_VERSION=1.4.1
BUILD_COMMIT=f1b8445a994e3b3eb9201e93c58d327b30664d9b
VOICE_CUDA_VISIBLE_DEVICES=
VOICE_ASR_DEVICE=cpu
VOICE_ASR_REQUIRE_CUDA=0
OLLAMA_CUDA_VISIBLE_DEVICES=
