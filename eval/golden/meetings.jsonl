{"id": "meetings-mileage-rate", "type": "retrieval", "namespace": "meetings", "persona": "Meeting Facilitator", "question": "What rate does the company reimburse when I use my personal car for business travel?", "expect_docs": ["Policy Handbook"], "expect_facts": [["EUR 0.42", "€0.42", "0.42/km", "0.42"]]}
