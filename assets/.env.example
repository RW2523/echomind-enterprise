# Multi-Agent Chatbot Stack – env vars for packaging / integration
# Copy to .env and adjust. Used by docker-compose.stack.yml and backend.

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
CONFIG_PATH=/app/config.json

# Models (comma-separated container names; must match model service names in compose)
MODELS=gpt-oss-20b

# Postgres (must match postgres service env)
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_password
POSTGRES_PORT=5432

# Milvus / Embedding (backend and RAG MCP use these; defaults work when stack+models run together)
# MILVUS_ADDRESS=milvus:19530
# EMBEDDING_SERVICE_URL=http://qwen3-embedding:8000
# EMBEDDING_MODEL=qwen3-embedding-custom

# Optional: volume base for etcd/minio/milvus data
# DOCKER_VOLUME_DIRECTORY=.
