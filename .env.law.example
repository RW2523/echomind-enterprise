# EchoMind Law — isolated compose stack settings (used by scripts/law/compose.sh).
# Copy to .env.law (gitignored) and fill in. Never commit .env.law.

# Required. Generate with: openssl rand -hex 32   (shared by backend and voice; >= 32 bytes)
LAW_AUTH_SECRET=
# Required. Initial admin password (re-seeded on every boot while set).
LAW_ADMIN_PASSWORD=
LAW_ADMIN_USER=admin

# Browser origins allowed to call the API (explicit list; '*' is refused by the Law edition).
LAW_CORS_ORIGINS=https://localhost:3543,http://localhost:3100

# Host ports for the Law frontend (production uses 3000/3443).
LAW_HTTP_PORT=3100
LAW_HTTPS_PORT=3543

# Shared model servers published on the host by the production stack (read-only use).
LAW_LLM_HOST_PORT=8355
LAW_OLLAMA_HOST_PORT=11435

# ASR stays on CPU and the GPU hidden by default: memory is unified and shared with production.
# To use the GPU, set LAW_ASR_DEVICE=cuda and LAW_BACKEND_CUDA_VISIBLE_DEVICES=0, after checking memory.
LAW_ASR_DEVICE=cpu
LAW_BACKEND_CUDA_VISIBLE_DEVICES=
LAW_VOICE_CUDA_VISIBLE_DEVICES=
LAW_VOICE_STARTUP_LOAD=0

# Refuse `up` when the host has less free memory than this (GB).
LAW_MIN_FREE_GB=12
