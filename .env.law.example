# EchoMind Law — isolated compose stack settings (used by scripts/law/compose.sh).
# Copy to .env.law (gitignored) and fill in. Never commit .env.law.

# Required. Generate with: openssl rand -hex 32   (shared by backend and voice; >= 32 bytes)
LAW_AUTH_SECRET=
# Required. Initial admin password (re-seeded on every boot while set).
LAW_ADMIN_PASSWORD=
LAW_ADMIN_USER=admin

# Required (D-014). Key that wraps every stored document's key. Keep it OUTSIDE the data volume and
# back it up separately: without it the stored documents cannot be opened. The pilot has its own key,
# never the development backend's (.law-secrets/master.key, which only ever protects fictional data).
# Create it once with:
#   install -m 600 /dev/null .law-secrets/pilot-master.key && openssl rand -base64 32 > .law-secrets/pilot-master.key
LAW_MASTER_KEY_FILE=./.law-secrets/pilot-master.key

# Browser origins allowed to call the API (explicit list; '*' is refused by the Law edition).
LAW_CORS_ORIGINS=https://localhost:3553,http://localhost:3110

# Host ports for the Law frontend (production uses 3000/3443; 3100 is taken by another stack on this host).
LAW_HTTP_PORT=3110
LAW_HTTPS_PORT=3553

# Shared model servers published on the host by the production stack (read-only use).
LAW_LLM_HOST_PORT=8355
LAW_OLLAMA_HOST_PORT=11435

# ASR stays on CPU and the GPU hidden by default: memory is unified and shared with production.
# To use the GPU, set LAW_ASR_DEVICE=cuda and LAW_BACKEND_CUDA_VISIBLE_DEVICES=0, after checking memory.
LAW_ASR_DEVICE=cpu
LAW_BACKEND_CUDA_VISIBLE_DEVICES=
LAW_VOICE_CUDA_VISIBLE_DEVICES=
LAW_VOICE_STARTUP_LOAD=0

# Refuse `up` when the host has less free memory than this (GB).
LAW_MIN_FREE_GB=12

# Images (D-060): built by scripts/law/build_images.sh from one commit; pin the tags it prints, so the
# pilot keeps running that commit whatever this checkout has checked out.
LAW_BACKEND_IMAGE=echomind-law-backend:latest
LAW_VOICE_IMAGE=echomind-law-voice:latest
LAW_FRONTEND_IMAGE=echomind-law-frontend:latest
# Memory caps per container. The host's memory is shared with production: a Law container that reaches
# its cap is stopped by the kernel, and under host-wide pressure Law containers are stopped first.
# The backend idles near 1.5 GB; the first live transcript loads speech recognition on CPU (about 5.7 GB
# more, kept until a restart), so its cap leaves room for that. The voice service idles near 1.6 GB (it
# preloads a second voice the Law edition does not use) and reads answers aloud for Conversation; at 2g a long
# answer stopped it (D-062).
LAW_BACKEND_MEM=8g
LAW_VOICE_MEM=3g
LAW_FRONTEND_MEM=256m

# Phase 4 features (D-058). The code keeps each one off; the owner turned all of them on for the
# pilot on 2026-10-11 (D-059). Set any of them to 0 to turn that feature off again.
# S4.1 intake with conflict screening (D-054).
LAW_INTAKE=1
# Single-use links for enquirers: the only Law routes without a sign-in (THREAT_MODEL T-24). They need
# LAW_INTAKE too. With no public ingress, links work only where the firm's network reaches this server.
LAW_INTAKE_LINKS=1
# Days before an unused enquirer link expires.
LAW_INTAKE_LINK_DAYS=14
# S4.2 cited summaries (D-055); uses the model.
LAW_SUMMARIES=1
# S4.3 time-entry drafts (D-056).
LAW_TIME_ENTRIES=1
# S4.5 four-perspective review panel (D-057); uses the model.
LAW_PANEL=1
# S5.1 the conversation assistant (D-062): spoken questions on a matter, answered and read aloud by this server.
LAW_CONVERSATION=1
# S4.4 regulatory updates (D-068): new UK legislation and US rules, fetched daily ON THE HOST by
# scripts/law/regulatory_daily.sh (cron) from legislation.gov.uk and the Federal Register, then imported;
# the Law containers never reach the internet.
LAW_REGULATORY=1
# OPT-02 machine translation (D-070): documents and summaries, by the answer model this server already uses;
# labelled as not reviewed, nothing stored.
LAW_TRANSLATION=1
